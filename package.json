{
  "name": "immuminati",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/rts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "npm run test && npm run build",
    "test:browser": "node scripts/rts-acceptance.mjs",
    "test:animation": "node scripts/rts-animation.mjs",
    "test:legacy-browser": "node scripts/acceptance.mjs",
    "test:legacy": "vitest run tests --exclude tests/rts/**",
    "preview:art": "vite --host 0.0.0.0 --open /Immuminati/#visual-lab",
    "test:extra": "node scripts/rts-extra-checks.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  }
}
